# NIRGuard repository hygiene

# 환경 변수 / 비밀값
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# 가상환경
.venv/
venv/
env/
ENV/

# 테스트/커버리지
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# 타입 체커
.mypy_cache/
.dmypy.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride


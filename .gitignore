*.mp4
*.mov
*.avi
*.mkv
demo/videos/
tests/fixtures/videos/

# 데모 DB (로컬 전용)
matching/*.db
matching/*.sqlite

# Node.js (데모 UI)
demo/node_modules/
demo/.next/
demo/.env.local

# 내부 전용 문서 (커밋 금지)
business/
docs/LEGAL_EVIDENCE_PLAYBOOK.md
docs/TAKEDOWN_WORKFLOW.md


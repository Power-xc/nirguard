      "path": "experiments/datasets/sample.png",
      "user_id": "user_003",
      "captures": [
        {
          "name": "iphone_15_pro_1m_center",
          "path": "experiments/datasets/sample_recapture.png",
          "metadata": {
            "display_model": "TBD",
            "panel_type": "TBD",

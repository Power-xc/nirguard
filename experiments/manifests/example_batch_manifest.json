            "angle_degrees": 0,
            "ambient_lux": null,
            "screen_brightness_percent": null,
            "notes": "Replace with a real recapture file before running."
          }
        }
      ]
    }
  ],
  "conditions": [
    {
      "name": "clean_export",
      "jpeg_quality": 100,
      "noise_sigma": 0,
      "downscale": 1.0
